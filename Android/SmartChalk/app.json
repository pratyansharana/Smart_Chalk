{
  "expo": {
    "name": "SmartChalk",
    "slug": "SmartChalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.smartchalk"
    },
    "android": {
      "package": "com.yourname.smartchalk",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#2D66C8",
          "defaultChannel": "smartchalk-updates"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SmartChalk to verify your identity before opening your account."
        }
      ],
      "@config-plugins/react-native-blob-util"
    ],
    "extra": {
      "eas": {
        "projectId": "b1c64ef8-fced-4f3e-91d3-438c91a00e4c"
      }
    }
  }
}
